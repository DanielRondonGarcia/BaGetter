@page
@model VulnerabilitiesModel
@using BaGetter.Web.Services
@using System.Globalization
@{
    ViewData["Title"] = "Vulnerabilities";
}

<div class="vulnerability-dashboard">
<div class="row">
    <div class="col-sm-12">
        <h2>Vulnerabilities</h2>
        <p class="text-muted">
            Hosted packages are scanned automatically: once at startup and then every hour,
            against the official NuGet vulnerability feed. The scan checks each hosted
            package's stored versions and its declared dependency ranges; the installed
            transitive dependency graph is not resolved.
        </p>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <div class="row">
            <div class="col-sm-8">
                <dl class="vulnerability-status-list">
                    <dt>Status</dt>
                    <dd>@Model.DisplayStatus</dd>
                    <dt>Last successful scan</dt>
                    <dd>
                        @(Model.LastSuccessfulScanText ?? "Never (no successful scan has completed yet)")
                    </dd>
                    @if (Model.Snapshot.IsStale)
                    {
                        <dt>Data freshness</dt>
                        <dd>Stale &mdash; the results shown are preserved from the last successful scan</dd>
                    }
                    @if (Model.Snapshot.IsStale || Model.EffectiveStatus == HostedVulnerabilityStatus.Failed)
                    {
                        <dt>Rescan</dt>
                        <dd>Use the "Rescan now" button; do not rely on the results below as current</dd>
                    }
                    @if (Model.Snapshot.Error != null)
                    {
                        <dt>Latest error</dt>
                        <dd>@Model.Snapshot.Error</dd>
                    }
                </dl>
            </div>
            <div class="col-sm-4">
                <form method="post" asp-page-handler="Refresh" class="vulnerability-rescan">
                    <button type="submit" class="btn btn-default">
                        <i class="ms-Icon ms-Icon--Refresh" aria-hidden="true"></i>
                        Rescan now
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="panel panel-default">
    <div class="panel-body">
        <h3>Export analysis history</h3>
        <p class="text-muted">
            Download the recorded analyses as a CSV file for a selected period of
            <strong>analysis dates (UTC).</strong> History only covers successful scans
            archived since <code>Vulnerabilities:History:Path</code> was configured:
            it starts now and is not backfilled, and this server applies no retention.
            An interval with no archived scans downloads the CSV header only.
        </p>
        @if (Model.ExportStatus == null || !Model.ExportStatus.IsConfigured)
        {
            <div class="alert alert-info" role="alert">
                <p>Vulnerability history is not configured (Vulnerabilities:History:Path),
                so there is no analysis history to export. Scans still run and the
                dashboard above stays available.</p>
            </div>
        }
        else if (Model.ExportStatus.Availability == VulnerabilityHistoryAvailability.Unavailable)
        {
            <div class="alert alert-danger" role="alert">
                <p><strong>The analysis history is currently unavailable, so CSV export is disabled.</strong>
                @(Model.ExportStatus.LastError ?? "The configured history path could not be read.")</p>
            </div>
        }
        else
        {
            @if (Model.ExportStatus.Availability == VulnerabilityHistoryAvailability.NoHistoryYet)
            {
                <div class="alert alert-info" role="alert">
                    <p>No vulnerability analysis has been archived yet. History begins with the
                    first successfully completed scan after the history path was configured;
                    earlier scans were not backfilled. A downloaded interval without archived
                    scans returns the CSV header only.</p>
                </div>
            }
            <form method="get" asp-page-handler="ExportCsv" class="vulnerability-export-form">
                <!-- Browser GET submissions replace the action's query with the
                     successful controls, so the handler must be carried as a
                     control value and not only inside the rendered action. -->
                <input type="hidden" name="handler" value="ExportCsv" />
                <div class="row">
                    <div class="col-sm-2">
                        <label class="vulnerability-export-label" for="vulnerability-export-from">From (UTC)</label>
                        <input class="form-control" type="date" id="vulnerability-export-from"
                               name="from" required min="0001-01-01" max="9999-12-31"
                               value="@Model.ExportTodayUtc" />
                    </div>
                    <div class="col-sm-2">
                        <label class="vulnerability-export-label" for="vulnerability-export-to">To (UTC)</label>
                        <input class="form-control" type="date" id="vulnerability-export-to"
                               name="to" required min="0001-01-01" max="9999-12-31"
                               value="@Model.ExportTodayUtc" />
                    </div>
                    <div class="col-sm-3">
                        <label class="vulnerability-export-label" for="vulnerability-export-package">Package ID (optional)</label>
                        <input class="form-control" type="text" id="vulnerability-export-package"
                               name="packageId" value="@Model.ExportPackageId"
                               placeholder="exact package ID (optional)" />
                    </div>
                    <div class="col-sm-2">
                        <label class="vulnerability-export-label" for="vulnerability-export-version">Version (optional)</label>
                        <input class="form-control" type="text" id="vulnerability-export-version"
                               name="version" value="@Model.ExportVersion"
                               placeholder="e.g. 1.2.3 (optional)" />
                    </div>
                    <div class="col-sm-3 vulnerability-export-submit">
                        <button type="submit" class="btn btn-default">
                            <i class="ms-Icon ms-Icon--Download" aria-hidden="true"></i>
                            Download CSV
                        </button>
                    </div>
                </div>
            </form>
        }
        @if (Model.ExportStatus != null && Model.ExportStatus.IsConfigured &&
             Model.ExportStatus.Availability != VulnerabilityHistoryAvailability.Unavailable &&
             Model.ExportStatus.LastError != null)
        {
            <div class="alert alert-warning" role="alert">
                <p><strong>A history problem was recorded</strong> (the archive may be incomplete);
                the dashboard's current analysis above remains valid.<br />
                @Model.ExportStatus.LastError</p>
            </div>
        }
    </div>
</div>

@if (Model.EffectiveStatus == HostedVulnerabilityStatus.NotScanned)
{
    <div class="alert alert-info" role="alert">
        <p>No vulnerability scan has completed yet. The first scan starts automatically
        shortly after the server starts and repeats every hour, or you can use the
        "Rescan now" button to start one immediately.</p>
    </div>
}
@if (Model.EffectiveStatus == HostedVulnerabilityStatus.Scanning)
{
    <div class="alert alert-info" role="alert">
        <p>A scan is running now. The results below are the last stable snapshot.</p>
    </div>
}
@if (Model.EffectiveStatus == HostedVulnerabilityStatus.Failed)
{
    <div class="alert alert-danger" role="alert">
        <p><strong>The last scan did not complete, so there is no new report.</strong> @Model.Snapshot.Error</p>
        @if (Model.Snapshot.HasSuccessfulScan)
        {
            <p>The results below are preserved from the last successful scan
            (@Model.LastSuccessfulScanText) and are stale.</p>
        }
    </div>
}
@if (Model.Snapshot.HasSuccessfulScan)
{
    <div class="panel panel-default">
        <div class="panel-body">
            <div class="row">
                <div class="col-sm-3">
                    <h4>@Model.PackageRowCount</h4>
                    <p class="text-muted">hosted package rows<br />(ID + version combinations)</p>
                </div>
                <div class="col-sm-3">
                    <h4>@Model.PackagesWithFindingsCount</h4>
                    <p class="text-muted">package rows with findings</p>
                </div>
                <div class="col-sm-3">
                    <h4>@Model.FindingCount</h4>
                    <p class="text-muted">findings (advisory associations;<br />@Model.ConfirmedFindingCount confirmed, @Model.PotentialFindingCount potential)</p>
                </div>
                <div class="col-sm-3">
                    <h4>@Model.UniqueAdvisoryCount</h4>
                    <p class="text-muted">unique advisories<br />(distinct advisory links)</p>
                </div>
            </div>
        </div>
    </div>

    @if (Model.FindingsBySeverity.Any())
    {
        <div class="vulnerability-severity-summary">
            <h3>Findings by severity</h3>
            <ul class="list-inline">
                @foreach (var severity in Model.FindingsBySeverity)
                {
                    <li><span class="label @VulnerabilitiesModel.SeverityBadgeClass(severity.Name)">@severity.Name</span> @severity.Count findings</li>
                }
            </ul>
        </div>
    }

    <h3>Hosted packages</h3>
    <p class="text-muted">
        Each section lists one hosted package (by ID, matched case-insensitively) —
        one package per section, regardless of how many stored versions it has.
        @Model.EffectivePackagePageSize packages load per page; additional
        packages continue on subsequent pages. A package's scanned
        versions load lazily when you expand its section (with a loading
        skeleton while the request completes), so opening this page never
        downloads every package's full version history. "Affected" means a
        stored exact version (or a pinned declared dependency) matches a known
        advisory; "Potential exposure" means a declared dependency range
        overlaps an advisory range and the installed version is not resolved.
        No known advisory is <strong>not covered</strong>, not "safe": packages that
        are private or simply unlisted cannot appear in the public advisory feed.
    </p>
    @if (Model.TotalPackageGroupCount > 0)
    {
        <p class="text-muted" aria-live="polite">
            Showing hosted packages @Model.FirstPackageNumber&ndash;@Model.LastPackageNumber
            of @Model.TotalPackageGroupCount (page @Model.PackagePageNumber of @Model.TotalPackagePages).
        </p>
        @* T2/S3: a plain GET Apply form — no JS dependency. Browser GET
           submissions replace the action's query with the successful
           controls, so the size and export prefills are carried as controls
           and pageNumber is deliberately absent: applying a size resets to
           page 1. A positive nonpreset size is shown as its own selected
           option instead of pretending to serve 50. *@
        <form method="get" asp-page="/Vulnerabilities" class="vulnerability-page-size-form">
            <label class="vulnerability-page-size-label" for="vulnerability-page-size">Packages per page</label>
            <select class="form-control" id="vulnerability-page-size" name="pageSize">
                @foreach (var option in VulnerabilitiesModel.PageSizeOptions)
                {
                    <option value="@option" selected="@(Model.EffectivePackagePageSize == option)">@option</option>
                }
                @if (!Model.EffectivePageSizeIsPreset)
                {
                    <option value="@Model.EffectivePackagePageSize" selected="selected">@Model.EffectivePackagePageSize</option>
                }
            </select>
            @if (Model.ExportPackageId != null)
            {
                <input type="hidden" name="exportPackageId" value="@Model.ExportPackageId" />
            }
            @if (Model.ExportVersion != null)
            {
                <input type="hidden" name="exportVersion" value="@Model.ExportVersion" />
            }
            <button type="submit" class="btn btn-default">Apply</button>
        </form>
    }

    @if (!Model.PackageGroups.Any())
    {
        <p class="text-muted">There are no hosted packages in the catalogue.</p>
    }

    @foreach (var group in Model.PackageGroups)
    {
        <details class="vulnerability-package" data-package-id="@group.PackageId" aria-busy="false">
            <summary>
                <strong>@group.PackageId</strong>
                <span class="label @VulnerabilitiesModel.StateBadgeClass(group.WorstState)">@VulnerabilitiesModel.StateLabel(group.WorstState)</span>
                <span class="text-muted">(@group.Versions.Count version@(group.Versions.Count == 1 ? "" : "s"), loaded when expanded)</span>
            </summary>
            @* Deliberately lazy: only a server-rendered placeholder lives here;
               the package's versions and findings are requested on expansion
               and never embedded in (or hidden inside) the initial page. *@
            <div class="vulnerability-package-details" data-package-details>
                <p class="text-muted">Expanding this package loads its scanned versions.</p>
            </div>
        </details>
    }

    @if (Model.TotalPackagePages > 1)
    {
        <nav aria-label="Hosted package pagination">
            <ul class="pager">
                <li class="previous">
                    @if (Model.HasPreviousPackagePage)
                    {
                        <a asp-page="/Vulnerabilities"
                           asp-route-pageNumber="@(Model.PackagePageNumber - 1)"
                           asp-route-pageSize="@Model.EffectivePackagePageSize"
                           asp-route-exportPackageId="@Model.ExportPackageId"
                           asp-route-exportVersion="@Model.ExportVersion">
                            <span aria-hidden="true">&larr;</span> Previous
                        </a>
                    }
                    else
                    {
                        <span aria-disabled="true">Previous</span>
                    }
                </li>
                <li class="next">
                    @if (Model.HasNextPackagePage)
                    {
                        <a asp-page="/Vulnerabilities"
                           asp-route-pageNumber="@(Model.PackagePageNumber + 1)"
                           asp-route-pageSize="@Model.EffectivePackagePageSize"
                           asp-route-exportPackageId="@Model.ExportPackageId"
                           asp-route-exportVersion="@Model.ExportVersion">
                            Next <span aria-hidden="true">&rarr;</span>
                        </a>
                    }
                    else
                    {
                        <span aria-disabled="true">Next</span>
                    }
                </li>
            </ul>
        </nav>
    }
}
</div>

@section Scripts {
    <script src="~/_content/BaGetter.Web/js/vulnerabilities.js" defer asp-append-version="true"></script>
}
